# Application
APP_ENV=local
NEXT_PUBLIC_APP_URL=http://localhost:3000
SESSION_COOKIE_NAME=rb_session

# Firebase client configuration (public Firebase identifiers)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (server only)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Shopee Open Platform (server only)
SHOPEE_ENV=sandbox
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_REDIRECT_URI=http://localhost:3000/api/shopee/callback

# 32 random bytes encoded as 64 hex characters or base64 (server only)
TOKEN_ENCRYPTION_KEY=
